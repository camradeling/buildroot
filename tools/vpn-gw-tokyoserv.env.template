# Site values for vpn-gw-tokyoserv.sh. Copy to vpn-gw-tokyoserv.env next to the
# script (not in git), or point VPN_GW_ENV at a copy elsewhere. All are required.

## The one OpenVPN client whose internet traffic is sent through the testbot
## (its ifconfig-push address from ccd/<its CN>)
CLIENT_IP=
## Any other client's address - status shows it still leaves via eth0
OTHER_IP=
## The testbot's tunnel address (its tun9)
GW_IP=
## The testbot's certificate CN - the ccd file that gets the iroutes
GW_CN=
## The OpenVPN server's client subnet, e.g. 10.8.0.0/24
VPN_NET=
## The server's client-config-dir and status log
CCD_DIR=
STATUS_LOG=

## Optional, these defaults are usually right
#DEV=tun0
#TABLE=1254
#PREF=1254
