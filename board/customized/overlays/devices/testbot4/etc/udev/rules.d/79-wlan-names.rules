# Onboard UWE5622 WiFi (platform/unisoc_wifi) -> wlan0
SUBSYSTEM=="net", ACTION=="add", KERNEL=="wlan*", DRIVERS=="unisoc_wifi", NAME="wlan0"
# AIC8800 USB WiFi -> wlan1
SUBSYSTEM=="net", ACTION=="add", KERNEL=="wlan*", SUBSYSTEMS=="usb", DRIVERS=="aic8800_fdrv", NAME="wlan1"
# MT7601U USB WiFi (148f:7601) -> wlan2
SUBSYSTEM=="net", ACTION=="add", KERNEL=="wlan*", SUBSYSTEMS=="usb", DRIVERS=="mt7601u", NAME="wlan2"
