[Unit]
Description=wpa_supplicant for wlan1 (WiFi client)
Wants=network.target
After=sys-subsystem-net-devices-wlan1.device network.target sshd.service rc-local.service
# preset-all recreates the .wants link after 0011-wifi_client_service.sh has run,
# so without this a WIFI_CLIENT=OFF image still associates to WLAN_SSID and
# installs a default route. 0011 removes the config when WIFI_CLIENT != ON.
ConditionPathExists=/etc/wpa_supplicant_wlan1.conf

[Service]
Type=simple
ExecStart=/sbin/wpa_supplicant -i wlan1 -c /etc/wpa_supplicant_wlan1.conf
# wlan1-client-setup.sh is gone: all it ever did was masquerade out wlan1 and add
# two FORWARD rules, and NAT is now installed once at boot by netpolicy.service,
# keyed on the LAN subnet rather than on an uplink. Hooking it here also meant
# restarting wpa_supplicant removed NAT for the whole board.
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
