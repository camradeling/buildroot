[Unit]
Description=DHCP client for wlan1
Wants=network.target
After=wpa_supplicant_wlan1.service
# Same gate as wpa_supplicant_wlan1.service: no client config, no DHCP on wlan1.
ConditionPathExists=/etc/wpa_supplicant_wlan1.conf

[Service]
Type=simple
ExecStart=/sbin/dhclient wlan1 -d
ExecStartPost=/etc/scripts/wlan1-fix-metric.sh
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
