#!/bin/bash
# Is the tunnel actually carrying traffic? Nothing else on this box knows.
#
# A dead xray process is systemd's problem (Restart=always) and a dead uplink is
# self-healing (xray dials per connection). The failure this exists for is the one
# in between: the process is alive, its inbounds accept, its rules are installed,
# and every connection through it dies - a server that is down, blocked, or whose
# REALITY handshake stopped being accepted. From the LAN that is a blackhole, and
# from the box it is indistinguishable from a working proxy: no watchdog fires, no
# unit fails, nothing appears in the log.
#
# So probe the only thing that can answer: a connection through xray to the
# internet. config.json carries a dokodemo-door inbound on 127.0.0.1:${PROBE_PORT}
# whose fixed destination is 1.1.1.1:80, so one HTTP request there exercises the
# whole path - inbound, outbound, REALITY handshake, server, exit. A bare connect
# would not: xray accepts the local socket before it dials anything, so the connect
# succeeds no matter how broken the tunnel is.
#
# Two escalations, in this order:
#   1. restart xray.service - the only recovery for a wedged process, and it runs
#      the whole del/add cycle, so it either comes back working or falls open.
#   2. take the TPROXY rules out (xraypolicy del) and leave them out while the
#      probe keeps failing, so the LAN uses the direct path that does work. With
#      XRAY_KILLSWITCH=ON that closes the LAN instead, which is the same promise.
# When the probe answers again, the rules go back (xraypolicy add). This is a
# reconciler, not a one-shot: the state file is what keeps it from re-running
# either action every tick.
#
# Run by xray-health.timer, every 60s.
#
# Usage: xray-health

set -u

. /etc/system.vars

UNIT=xray.service
PROBE_PORT=${XRAY_PROBE_PORT:-5301}
PROBE_TIMEOUT=5

## The one destination both probes use, and the one config.json's probe inbound
## points at - keep the two in step. 1.1.1.1:80 answers with a 301 to https, which
## is proof enough that a path exists, and it is anycast, so it is as close as
## anything gets to reachable from every carrier.
PROBE_HOST=1.1.1.1
PROBE_HTTP_PORT=80

## Consecutive failures before anything is touched. One failed probe is a packet
## loss report, not a diagnosis: 3 x 60s means a real outage is acted on in about
## three minutes and a lossy minute is ignored.
THRESHOLD=${XRAY_HEALTH_FAILS:-3}
## And no more than one restart per this many seconds. A restart drops every live
## connection through the tunnel, so a server that is down for an hour must not
## turn into a restart every three minutes.
COOLDOWN=${XRAY_HEALTH_COOLDOWN:-300}

## /run, so a reboot starts from a clean slate - which is right, because the rules
## and the routing start from a clean slate too.
STATE_DIR=/run/xray-health
FAILS_FILE=${STATE_DIR}/fails
STATE_FILE=${STATE_DIR}/state
RESTART_FILE=${STATE_DIR}/last-restart

log()
{
	logger -t xray-health "$*"
}

read_num()
{
	_v=$(cat "${1}" 2>/dev/null)
	case "${_v}" in
	''|*[!0-9]*)	echo 0 ;;
	*)		echo "${_v}" ;;
	esac
}

## One bounded HTTP request. bash's /dev/tcp and "read -t", not nc, and that is a
## field finding, not a preference: this box has no timeout(1), and GNU netcat
## 0.7.1's -w does not bound the *read*. Measured on the live board with the
## tunnel's egress blackholed - "printf ... | nc -w 5 127.0.0.1 5301" was still
## running after 25s with zero bytes read, every tick, so systemd killed the unit
## at TimeoutStartSec and the counter below never advanced. The health check
## became the outage it exists to detect. read -t returns 142 in exactly five
## seconds on the same connection.
##
## HTTP/1.0 with no keepalive, so the far end closes and the read cannot block on
## a connection nobody will say anything more on.
probe()
{
	_host=$1
	_port=$2
	_line=""
	_rc=0

	## The connect itself is the one part that is not bounded, and it does not
	## need to be for ${PROBE_PORT}: xray is listening (checked above), so the
	## kernel completes it from the backlog whatever state xray is in. Its error
	## goes to /dev/null because this function's job is to return true or false -
	## the caller does the reporting.
	{ exec 3<>"/dev/tcp/${_host}/${_port}"; } 2>/dev/null || return 1

	printf 'HEAD / HTTP/1.0\r\nHost: %s\r\nConnection: close\r\n\r\n' "${_host}" >&3 2>/dev/null
	IFS= read -t ${PROBE_TIMEOUT} -r _line <&3
	_rc=$?
	exec 3<&- 3>&-

	## rc 0 = a line arrived, 1 = the far end closed without one, >128 = it said
	## nothing for ${PROBE_TIMEOUT}s. Only the first can be a working path.
	[ ${_rc} -eq 0 ] || return 1
	case "${_line}" in
	HTTP/1.[01]\ *)	return 0 ;;
	esac
	return 1
}

## Through the tunnel: local inbound, so this works whether or not the TPROXY
## rules are installed - which is what lets a fallen-open LAN be put back.
probe_tunnel()
{
	probe 127.0.0.1 ${PROBE_PORT}
}

## Straight out of the box, no tunnel. Locally generated traffic never enters
## PREROUTING (see xraypolicy), so this is the direct path even while the LAN is
## being proxied, and the kill switch only ever touches FORWARD, so it cannot
## block it either.
probe_direct()
{
	probe ${PROBE_HOST} ${PROBE_HTTP_PORT}
}

#####################################################################
## the two escalations, in one place: they have to be reachable from the recorded
## state alone (see below), not only from a probe that came back
#####################################################################
## Set by escalate() when it did something, so the caller knows whether the tick
## still owes the journal a line.
ACTED=""

escalate()
{
	_now=$(date +%s)
	_last=$(read_num ${RESTART_FILE})
	ACTED=""

	if [ $(( _now - _last )) -ge ${COOLDOWN} ]; then
		log "no HTTP reply through the tunnel after ${FAILS} probes, restarting ${UNIT}"
		echo ${_now} > ${RESTART_FILE}
		## Give the new process a full THRESHOLD of ticks before it is judged.
		echo 0 > ${FAILS_FILE}
		FAILS=0
		systemctl restart ${UNIT}
		## The restart's ExecStartPost put the rules back. If the tunnel was
		## already known not to work, take them out again straight away rather
		## than blackhole the LAN for another three minutes on every attempt.
		if [ "${STATE}" = "down" ]; then
			/usr/sbin/xraypolicy del
		fi
		ACTED=restart
		return 0
	fi

	if [ "${STATE}" = "up" ]; then
		log "the tunnel is still dead after a restart, taking the TPROXY rules out" \
			"so the LAN uses the direct path"
		/usr/sbin/xraypolicy del
		echo down > ${STATE_FILE}
		STATE=down
		ACTED=fall-open
		return 0
	fi

	## Nothing left to do: the rules are already out and the cooldown has not
	## expired. Silent on purpose - this function also runs *before* this tick has
	## probed anything, and "the tunnel is still dead" is not a claim this tick has
	## yet earned. The caller says it once it has a failed probe to say it about.
}

#####################################################################
## preconditions: things that are not the tunnel's fault
#####################################################################
## Nothing to probe and nothing to restart.
[ "${XRAY_CLIENT:-OFF}" = "ON" ] || exit 0

## Not running: either it is between Restart=always attempts or it was stopped on
## purpose. Both are already the right state - the rules came out with it - and
## restarting it here would fight whoever stopped it.
systemctl is-active --quiet ${UNIT} || exit 0

#####################################################################
mkdir -p ${STATE_DIR} 2>/dev/null

FAILS=$(read_num ${FAILS_FILE})
STATE=$(cat ${STATE_FILE} 2>/dev/null)
[ "${STATE}" = "down" ] || STATE=up

## Act on what is already recorded *before* probing anything. The probe is bounded
## now, but a probe that wedges anyway - a connect that blocks, a signal, an OOM
## kill - must not be able to stall the escalation forever, which is exactly what
## the field failure looked like: every tick killed at TimeoutStartSec, so the tick
## that would have acted never ran. The state file is the input, not this tick's
## measurement.
if [ ${FAILS} -ge ${THRESHOLD} ]; then
	escalate
fi

## And record this attempt as a failure before making it, for the same reason: if
## this process does not survive its own probe, the failure still counted.
echo $(( FAILS + 1 )) > ${FAILS_FILE}

if probe_tunnel; then
	echo 0 > ${FAILS_FILE}
	if [ "${STATE}" = "down" ]; then
		log "the tunnel answers again after ${FAILS} failed probes, putting the LAN back on it"
		/usr/sbin/xraypolicy add
		echo up > ${STATE_FILE}
	fi
	exit 0
fi

FAILS=$(( FAILS + 1 ))

## Nothing came back - but is there anything out there at all? A modem that lost
## its carrier looks exactly like a dead server from inside the tunnel, and without
## this the box would restart xray every five minutes for as long as it takes to
## get signal back, and repath a LAN onto a direct path that is just as dead.
##
## This replaces a "does a default route exist" check, which was measured to be
## worthless on this board: usb0 carries a static default route at metric 2000, so
## a default route always exists, carrier or no carrier. Asking the network is the
## only honest form of the question - and it costs one HEAD request, only ever on a
## tick that already failed.
if ! probe_direct; then
	echo 0 > ${FAILS_FILE}
	log "no reply through the tunnel and none on the direct path either:" \
		"the uplink is down, so this is not the tunnel's fault"
	exit 0
fi

if [ ${FAILS} -ge ${THRESHOLD} ]; then
	escalate
	if [ -z "${ACTED}" ]; then
		log "the tunnel is still dead (${FAILS} consecutive probes), the LAN stays off it"
	fi
	exit 0
fi

log "no HTTP reply through the tunnel, the direct path answers (${FAILS}/${THRESHOLD})"
exit 0
