#!/bin/bash
################3 username #############################################
export USERDIR=/home/${USER}
################# system variables file ################################
export SYSTEM_VARS_FILE=/etc/system.vars
export BOARD_VERSION=orangepi_zero3
################# boot script ##########################################
export SRCBOOTINIFILE=boot4.cmd
################# device hostname ######################################
export DEV_HOSTNAME="orange"
################# ssh keys #############################################
export SSH_KEY_FILES_LIST="/home/claudea/.ssh/id_rsa_camradeling.pub /home/claudea/.ssh/id_rsa_zero3.pub"
################# vpn config file ######################################
export VPN_CLIENT=OFF
export VPN_CONFIG=/home/denisov/vpn/officehub.conf
################# network configuration ################################
export DEVICE_IFACE="eth0"
export DEVICE_STATIC_ADDR="ON"
export DEVICE_STATIC_IPADDR="192.168.7.100"
export DEVICE_STATIC_NETMASK="255.255.255.0"
#export DEVICE_STATIC_GATEWAY="192.168.7.11"
export DEVICE_DHCP_ADDR=ON
export DEVICE_DNS_SERVER=1.1.1.1
################# gpio pins variables ##################################
export VPN_LED=OFF
export VPN_LED_PIN=
export VPN_LED_PIN_INVERT=false
export GREEN_LED_PIN=23
export GREEN_LED_PIN_INVERT=false
export SMART_GREEN_LED_PIN=
export SMART_GREEN_LED_PIN_INVERT=false
export RED_LED_PIN=24
export RED_LED_PIN_INVERT=false
################ usb gadget device #####################################
export USB_GADGET_DEVICE=ON
export USB_RNDIS=ON
export USB_MASS_STORAGE=OFF
################ wifi client ###########################################
export WIFI_CLIENT=OFF
export WIFI_CLIENT_WLAN_NAME=wlan1
export WLAN_SSID=Tamasha
# WLAN_PSK is in orangepi4-test.secrets (not in git)
################ wifi access point #####################################
export WIFI_AP=ON
export WIFI_AP_WLAN_NAME=wlan0
export WIFI_AP_ADDR=192.168.3.1
export WIFI_AP_NETMASK=255.255.255.0
export WIFI_AP_SSID=INP3
# WIFI_AP_PSK is in orangepi4-test.secrets (not in git)
export WIFI_AP_BSS_TRANSITION=ON
################ quectel gsm modem #####################################
# ON installs a udev hook that switches a plugged Quectel modem to ECM
export QUECTEL_ECM=ON
################ xray vpn client #######################################
# ON generates /etc/xray/config.json from XRAY_CONFIG and lets xray.service
# start; everything forwarded from XRAY_LAN_IFACES then goes into the tunnel
# (TPROXY), while the board's own traffic keeps going out directly.
export XRAY_CLIENT=ON
# Client config to import. A vless:// REALITY share URL, a sing-box JSON
# outbound, or a ready-made xray config.json - 0013 detects which. No credential
# is ever a variable: uuid/pbk/sid exist only in this file, which is not in git.
export XRAY_CONFIG=/home/denisov/vpn/laptop-singapore/singbox-reality.txt
# Everything below has a working default; set only to override
export XRAY_TPROXY_PORT=12345
# The DNS inbound's own loopback address, on port 53. An address rather than a port
# because dnsmasq reaches it through a resolv-file, and a nameserver line has no
# port. Not 127.0.0.53/.54 (systemd-resolved), and never port 5353 - that is mDNS,
# resolved binds it, and xray exits on a failed bind.
export XRAY_DNS_ADDR=127.0.0.2
# The resolver behind all of it: through the tunnel while it is up, directly from
# the board while it is down.
export XRAY_DNS_UPSTREAM=1.1.1.1
# Loopback port of the inbound xray-health probes to decide whether the tunnel
# still carries traffic.
export XRAY_PROBE_PORT=5301
export XRAY_LAN_IFACES="usb0 wlan0"
# ON means a dead Xray takes the LAN's way out with it instead of falling back to
# direct NAT. OFF while this box is reached through that LAN.
export XRAY_KILLSWITCH=OFF
# Seconds of silence before the tunnel's TCP connections to the server send a
# keepalive probe; OFF keeps xray's default. Must be under the shortest idle
# timeout on the uplink path - this carrier forges an RST into any tunnel
# connection silent for ~30 s, so 20 here. Ignored for a verbatim config.json.
export XRAY_TCP_KEEPALIVE=20
################ wireguard vpn client ##################################
# ON brings up wg0 from WG_CONFIG at boot (wg-client.service) and probes it
# every minute (wg-health.timer): after 3 failed probes it recreates wg0, which
# also gives it a new source port through the carrier's NAT.
export WG_CLIENT=OFF
# A wg-quick style client config: [Interface] PrivateKey/Address/DNS/MTU and
# [Peer]s. The Endpoint must be an IP literal. Not in git: it holds the key.
export WG_CONFIG=/home/denisov/vpn/camradeling_laptop-singapore/wireguard/generated/client_linux.conf
# ON routes everything the LAN sends to the internet, and the LAN's DNS, through
# wg0 (falling back to the direct path while wg-health finds the tunnel dead).
# Needs XRAY_CLIENT=OFF - only one of them can own the LAN's way out. OFF only
# brings the interface up.
export WG_LAN_ROUTE=ON
# Everything below has a working default; set only to override
# Seconds between keepalives (OFF for none); overrides the config's
# PersistentKeepalive. Keeps the carrier's UDP mapping alive while idle.
export WG_KEEPALIVE=25
# What wg-health pings through the tunnel to decide it works.
export WG_PROBE_ADDR=1.1.1.1
export WG_LAN_IFACES="usb0 wlan0"
# WG_MTU and WG_DNS default to the config's MTU / first IPv4 DNS, else 1420 / 1.1.1.1
# Must not exceed the server's wg0 MTU: the server runs 1392, and with the
# default 1420 the MSS clamp let through segments the server cannot forward into
# its end of the tunnel - every TLS handshake took 5-6 s waiting on PMTU recovery.
export WG_MTU=1392
